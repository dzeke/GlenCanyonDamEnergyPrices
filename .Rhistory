nStartHourOffPeak <- 6
nEndHourOffPeak <- nStartHourOffPeak + 8
dfAllData$Period <- ifelse((dfAllData$Hour >= nStartHourOffPeak) & (dfAllData$Hour <= nEndHourOffPeak), "Off-peak", "On-peak")
